# Token del bot (Developer Portal → Bot → Token). Non è il Client Secret.
DISCORD_TOKEN=

# Dal pannello della routine Grok Bot. WEBHOOK_AUTHORIZATION è il valore
# completo dell'header, per esempio "Bearer xxxxx". Non scrivere "Authorization:".
WEBHOOK_URL=
WEBHOOK_AUTHORIZATION=

# Opzionali. Lascia vuoto per non filtrare.
# ID Discord numerici, separati da virgola. Accetta anche <@123> e <#123>.
OWNER_USER_ID=
GUILD_IDS=
CHANNEL_IDS=

# all (predefinito) oppure mentions
FORWARD_MODE=all

# Raggruppa i messaggi consecutivi della stessa conversazione (canale, thread o DM)
# in un solo POST. Ogni messaggio nuovo azzera il timer.
# FORWARD_DEBOUNCE_MS=0 invia subito ogni messaggio, senza raggruppare.
# Predefiniti: 120000 (2 minuti), 20 messaggi, 600000 (10 minuti).
FORWARD_DEBOUNCE_MS=120000
FORWARD_MAX_BATCH=20
FORWARD_MAX_WAIT_MS=600000

# Server MCP. Se è vuota, /mcp non parte: restano l'inoltro e GET /health.
# Generala con: openssl rand -hex 32
MCP_API_KEY=

# true (predefinito) registra i tool che scrivono come il bot. false li omette.
ALLOW_WRITE=true

# Porta HTTP. Railway e Render impostano PORT da soli: non sovrascriverla lì.
# PORT=3000
